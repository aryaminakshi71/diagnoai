# DiagnoAI — copy to .env and fill in. Never commit real values.

# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lab_registers

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Admin ---
ADMIN_TOKEN=

# --- Server ---
PORT=3000

# --- Optional integrations ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── Read replica (optional) ──────────────────────────────────────────────────
# Point analytics/dashboard reads at a Neon read replica so they don't compete
# with writes. Leave empty to use the primary for everything.
DATABASE_READ_URL=
